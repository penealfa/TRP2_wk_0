{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/heritage-short/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Every stage reads this file; nothing else carries prompts, seeds or timing.",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "logline",
    "language",
    "audience",
    "style",
    "characters",
    "defaults",
    "shots",
    "music",
    "end_card"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string",
      "minLength": 10,
      "description": "One sentence that sums up the story."
    },
    "notes": {
      "type": "string"
    },
    "language": {
      "type": "object",
      "required": [
        "code",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
          "description": "BCP-47 style code of the narration language, e.g. am, om, ti, en."
        },
        "name": {
          "type": "string"
        }
      }
    },
    "audience": {
      "type": "object",
      "required": [
        "who",
        "where",
        "feeling"
      ],
      "additionalProperties": false,
      "properties": {
        "who": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "feeling": {
          "type": "string",
          "description": "What they should feel or understand when it ends."
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "style_block"
      ],
      "additionalProperties": false,
      "properties": {
        "style_block": {
          "type": "string",
          "minLength": 10,
          "description": "Fixed text appended to every keyframe prompt."
        },
        "negative": {
          "type": "string"
        },
        "reference_sheet_prompt": {
          "type": "string",
          "description": "Prompt for the style/character reference sheet generated before any keyframe."
        },
        "reference_seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "real_person"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Fixed visual description attached to every prompt that features this character."
          },
          "real_person": {
            "type": "boolean"
          },
          "consent_ref": {
            "type": "string",
            "description": "Anchor in ETHICS.md recording consent. Required when real_person is true."
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "ref_framing": {
            "enum": [
              "portrait",
              "full_body"
            ],
            "description": "How the reference sheet frames this character. FLUX.2 copies the reference's framing into shots, so a face-led character works best as a portrait."
          }
        },
        "if": {
          "properties": {
            "real_person": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "consent_ref"
          ]
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "keyframe_model",
        "video_model",
        "tts_model",
        "voice",
        "fps"
      ],
      "additionalProperties": false,
      "properties": {
        "keyframe_model": {
          "type": "string"
        },
        "video_model": {
          "type": "string"
        },
        "tts_model": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "tts_style": {
          "type": "string",
          "description": "Short delivery instruction, e.g. 'calm, warm, unhurried'."
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30
          ]
        },
        "video_resolution": {
          "type": "string",
          "enum": [
            "480p",
            "720p"
          ]
        },
        "keyframe_width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 2048
        },
        "keyframe_height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 2048
        },
        "narration_source": {
          "enum": [
            "recorded",
            "tts"
          ],
          "description": "recorded = use recordings/<shot_id>.wav (or .m4a/.mp3/.ogg) and fall back to TTS for missing lines; tts = always Gemini TTS."
        },
        "narrator": {
          "type": "string",
          "description": "Who voices the film. A real person needs a consent record in ETHICS.md."
        },
        "voices": {
          "type": "object",
          "description": "Per-speaker voice settings, keyed by speaker id (a character id).",
          "additionalProperties": {
            "type": "object",
            "required": [
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "enum": [
                  "recorded",
                  "tts"
                ],
                "description": "recorded = recordings/<shot_id>.<ext>, TTS fallback; tts = always TTS"
              },
              "voice": {
                "type": "string",
                "description": "TTS voice name"
              },
              "style": {
                "type": "string",
                "description": "TTS delivery instruction for this speaker"
              }
            }
          }
        },
        "motion_backend": {
          "enum": [
            "kaggle",
            "blender"
          ],
          "description": "How shots get motion: kaggle = Wan 2.2 clips (pan-and-zoom where missing); blender = a Cloudflare model writes each Blender camera move and Blender renders it locally. Overridden by --motion or HS_MOTION."
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "music": {
      "type": "object",
      "required": [
        "caption",
        "duration_s",
        "cues"
      ],
      "additionalProperties": false,
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 10,
          "description": "ACE-Step caption: style, mood, instruments, texture, era. No tempo or key here."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lyrics": {
          "type": "string",
          "description": "Use [instrumental] for a score."
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 240
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ],
          "description": "Candidate id chosen for the film, e.g. 'c2'. null = first available."
        },
        "chosen_reason": {
          "type": "string"
        },
        "duck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "ratio": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            },
            "music_gain_db": {
              "type": "number"
            }
          }
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "starts_at_shot",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "starts_at_shot": {
                "$ref": "#/$defs/slug"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": [
        "lines",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "type": "string",
            "pattern": "(?i)\\bAI\\b"
          },
          "description": "Must include a visible statement that the film was made with AI."
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "duration_s",
        "shot_size",
        "reason",
        "keyframe",
        "motion",
        "narration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 15,
          "description": "Minimum on-screen time; assembly extends it if the narration is longer."
        },
        "shot_size": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium",
            "medium_close_up",
            "close_up",
            "extreme_close_up",
            "insert"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why this shot exists, in one sentence."
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "keyframe": {
          "type": "object",
          "required": [
            "prompt",
            "seed"
          ],
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 10
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "approved": {
              "type": "boolean",
              "description": "Set true after checking face/hands; shots stage skips unapproved keyframes unless --force."
            }
          }
        },
        "motion": {
          "type": "object",
          "required": [
            "prompt",
            "fallback"
          ],
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "description": "Motion and camera only; the keyframe already holds the subject."
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "mode": {
              "enum": [
                "i2v",
                "still"
              ],
              "description": "still = never send to the GPU, always pan-and-zoom."
            },
            "fallback": {
              "enum": [
                "push_in",
                "pull_out",
                "pan_left",
                "pan_right",
                "static"
              ]
            }
          }
        },
        "narration": {
          "type": "object",
          "required": [
            "text",
            "text_en"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "description": "Narration in the film's language. Empty string = no narration on this shot."
            },
            "text_en": {
              "type": "string",
              "description": "English subtitle text."
            },
            "style": {
              "type": "string",
              "description": "Per-line delivery override."
            },
            "offset_s": {
              "type": "number",
              "minimum": 0,
              "maximum": 5,
              "description": "Delay from shot start before the line begins."
            },
            "speaker": {
              "$ref": "#/$defs/slug",
              "description": "Character id who speaks this line; must exist in defaults.voices when voices is set."
            }
          }
        },
        "music_cue": {
          "$ref": "#/$defs/slug"
        },
        "overlays": {
          "type": "array",
          "description": "Text drawn in code over the shot (labels, dates). Never put text in image prompts.",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              },
              "position": {
                "enum": [
                  "top",
                  "upper_third",
                  "center",
                  "lower_third"
                ]
              }
            }
          }
        }
      }
    }
  }
}
