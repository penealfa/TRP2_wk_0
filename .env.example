# Copy to .env (never commit .env). Every key here is free-tier.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
CLOUDFLARE_ACCOUNT_ID=     # dash.cloudflare.com -> Workers AI -> "Use REST API"
CLOUDFLARE_API_TOKEN=      # token with Workers AI: Read + Edit
KAGGLE_USERNAME=           # only for `make kaggle-shots`; the kaggle CLI also reads ~/.kaggle/kaggle.json

# Optional overrides (model ids move often; check with `make smoke`)
# HS_TEXT_MODEL=gemini-3.8-flash
# HS_KEYFRAME_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# HS_MAX_ATTEMPTS=3
# HS_OFFLINE=1             # placeholder generators, no network

# Blender motion layer (`make film-blender`)
# BLENDER_EXE=E:\Blender\blender.exe    # else `blender` on PATH
# HS_BLENDER_LLM=cloudflare               # cloudflare (default) or gemini
# HS_MOTION=blender                       # same as --motion blender
