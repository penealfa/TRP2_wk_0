    "duration_s": 6.12,
    "text": "ስክሪኑ መጀመሪያ \"Hello, World\" ብሎ ሲመልስልህ ታስታውሳለህ?",
    "speaker": "wolf",
    "voice": "Kore",
    "source": "tts"
  },
  "s10": {
